# Gedeeld geheim tussen poller en dashboard voor /api/measurements.
# Genereer er een met:  openssl rand -hex 32
INGEST_TOKEN=verander-dit-in-een-willekeurige-string

# Seriele poort van de USB->RS485-adapter, zoals de poller-container hem ziet.
# Op de host mapt docker-compose het stabiele /dev/serial/by-id/...-pad hierop.
MODBUS_PORT=/dev/ttyUSB0

# Modbus slave-adres van de sensor (standaard 0x01).
MODBUS_SLAVE_ID=1

# Pollinterval in seconden. 300 = elke 5 minuten, zoals in PROJECT-DESIGN.md.
POLL_INTERVAL_SECONDS=300

# Grenzen waarbinnen een meting geloofwaardig is. De dode zone van de sensor is
# 0-25 cm, het bereik gaat tot 5 m. Een antwoord daarbuiten (typisch 0 mm, als
# de echo niet terugkomt) wordt als storing bewaard in plaats van als meting --
# anders rekent een kapotte sensor door als een volle put.
SENSOR_MIN_MM=250
SENSOR_MAX_MM=5000
