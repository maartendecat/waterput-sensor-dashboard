# Kopieer dit naar .env naast docker-compose.yml. Compose leest dat bestand op
# de host om de ${...}-plaatshouders in docker-compose.yml in te vullen; het
# bestand zelf komt nooit in een container terecht.

# Gedeeld geheim tussen poller en dashboard voor /api/measurements.
# Genereer er een met:  openssl rand -hex 32
INGEST_TOKEN=verander-dit-in-een-willekeurige-string

# Het stabiele pad van de USB->RS485-adapter op deze machine. Zoek het op met:
#   ls -l /dev/serial/by-id/
# Nooit kaal /dev/ttyUSB0: dat hernummert zodra er een tweede USB-apparaat bij
# komt, en dan is je sensor op een dinsdag zomaar weg.
MODBUS_DEVICE=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_XXXX-if00-port0

# --- Hieronder is alles optioneel; weglaten betekent de waarde ernaast. ---

# Slave-adres van de sensor.
#MODBUS_SLAVE_ID=1

# 0x0100 = 256, de gefilterde afstand. Levert dat niets op, probeer dan eerst
# het naburige adres voor je aanneemt dat de sensor stuk is.
#MODBUS_REGISTER=256

# Pollinterval in seconden. 300 = elke vijf minuten.
#POLL_INTERVAL_SECONDS=300

# Grenzen waarbinnen een meting fysiek mogelijk is: de sensor meet van 200 mm
# tot 5 m. Een antwoord daarbuiten (typisch 0 mm, als de echo niet terugkomt)
# wordt als storing bewaard in plaats van als meting -- anders rekent een
# kapotte sensor door als een volle put.
# Let op: 200 mm is de sensorspecificatie, niet de montagemarge van 25 cm.
#SENSOR_MIN_MM=200
#SENSOR_MAX_MM=5000

# Ping-URL van een check op https://healthchecks.io. De poller pingt na elke
# meting die in de database staat; blijven de pings weg, of mislukken er
# HEALTHCHECK_FOUTEN_VOOR_ALARM rondes op rij, dan krijg je een melding.
# Leeg laten = geen pings. Zie README.md, "Verwittigd worden bij een storing".
#HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#HEALTHCHECK_FOUTEN_VOOR_ALARM=6
